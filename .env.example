# ===========================================================================
# WinCleaner Licensing Server Environment Configuration
# ===========================================================================

# Server Settings
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=production

# Database Settings
# On Render: automatically populated from DATABASE_URL
# For Local Testing: sqlite+aiosqlite:///./licensing.db
DATABASE_URL=sqlite+aiosqlite:///./licensing.db

# Telegram Bot (from @BotFather)
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ
BOT_USERNAME=WinCleanerLicenseBot

# Comma-separated Telegram User IDs with admin privileges
ADMIN_IDS=123456789,987654321

# Ed25519 Cryptographic Keys (Hex format, 32 bytes = 64 hex characters)
# Generate new pair with: python generate_keys.py
ED25519_PRIVATE_KEY_HEX=adbb08e9c7ed6ee0cee470ea624cc9a55b160c84ea15858cd619e0a94f18139e
ED25519_PUBLIC_KEY_HEX=acba32615e13044a3d15823b07ed600e9384c34b79eab06aa88f8c08fada9457

# Admin Secret Token for direct REST API administration
ADMIN_SECRET=super-secret-admin-token-for-api-calls
